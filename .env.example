# ==========================================
# RDX MOVIE FEED BOT - CONFIGURATION
# ==========================================

# 1. Telegram Bot Token from @BotFather (Required)
BOT_TOKEN=1234567890:ABCdefGhIJKlmNoPQRsTUVwxyZ

# 2. Telegram Target Channel ID or Username (Required)
# Bot-কে অবশ্যই আপনার চ্যানেলে Admin বানিয়ে Post Messages পারমিশন দিতে হবে!
CHANNEL_ID=-1001234567890

# 3. Leech Bot Username(s) for inline [📥 Leech] buttons
# একটি বট থাকলে: RDX_Leech_Bot
# একাধিক বট থাকলে কমা দিয়ে লিখুন: RDX_Leech_Bot, RDX_VIP_Bot
LEECH_BOT_USERNAMES=RDX_Leech_Bot, RDX_VIP_Bot

# 4. Check Interval in seconds (Default: 300 = 5 minutes)
CHECK_INTERVAL=300

# 5. Database (MongoDB Atlas URI recommended for Heroku / Koyeb)
# যদি খালি রাখেন, তবে লোকাল SQLite ফাইল (data/history.db) ব্যবহার হবে।
DATABASE_URL=mongodb+srv://username:password@cluster.mongodb.net/?retryWrites=true&w=majority

# 6. Admin Telegram User IDs (কমা দিয়ে একাধিক দিতে পারেন)
ADMIN_IDS=123456789

# 7. Web Server Port (Heroku ও Koyeb অটোমেটিক সেট করে দেয়)
PORT=8080

# 8. Source Domains (দরকার হলে নতুন মিরর ডোমেন দিতে পারেন)
MLSBD_FEED=https://mlsbd.co/feed/
VEGAMOVIES_URL=https://vegamovies.lease
FOURKHDHUB_URL=https://4khdhub.one
MOVIESMOD_URL=https://moviesmod.tw

# SkyMoviesHD: খালি রাখলে skybap.site থেকে অটোমেটিক নতুন ডোমেন ডিটেক্ট করবে!
# অথবা নিজে থেকে নির্দিষ্ট ডোমেন দিতে পারেন (যেমন: https://new4.skymovieshd.clinic)
SKYMOVIES_URL=

# 9. Source Toggles (True/False)
ENABLE_MLSBD=true
ENABLE_VEGAMOVIES=true
ENABLE_FOURKHDHUB=true
ENABLE_MOVIESMOD=true
ENABLE_SKYMOVIES=true

# 10. Initial Run Behavior:
# ট্রু থাকলে প্রথমবার চালু হলে আগের মুভিগুলো দিয়ে চ্যানেল স্প্যাম করবে না,
# শুধু নতুন আসা মুভিগুলো চ্যানেলে পোস্ট করবে।
INITIAL_MARK_SEEN=true
